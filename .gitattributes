# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicitly preserve CRLF fixtures across all checkouts and platforms
fixtures/**/CRLF* text eol=crlf
fixtures/**/CRLF*.md text eol=crlf
"fixtures/vaults/main_vault/Meetings/CRLF Note.md" text eol=crlf
fixtures/vaults/main_vault/Meetings/CRLF\ Note.md text eol=crlf
